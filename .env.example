# Puertos locales (los valores por defecto evitan choques con otros proyectos)
DB_PORT=5442
API_PORT=3101
WEB_PORT=3100
PROXY_PORT=8180

NODE_ENV=development
DATABASE_URL=postgres://habitos:habitos@127.0.0.1:5442/habitos
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Secreto anterior opcional, para rotar JWT_SECRET sin cerrar sesiones
JWT_SECRET_PREVIOUS=
JWT_ISSUER=habitos
# Genera con: pnpm --filter @habitos/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# URL interna con la que Next llama a la API al renderizar en servidor
API_INTERNAL_URL=http://127.0.0.1:3101
PUBLIC_URL=http://localhost:8180
