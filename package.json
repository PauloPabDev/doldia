{
  "name": "habitos",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm infra:up && turbo run dev",
    "bootstrap": "node scripts/init-env.mjs && pnpm infra:up && pnpm db:migrate && pnpm db:seed",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml --env-file .env up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml --env-file .env down",
    "build": "turbo run build",
    "start": "pnpm infra:up && pnpm --parallel --filter @habitos/api --filter @habitos/web start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @habitos/api db:generate",
    "db:migrate": "pnpm --filter @habitos/api db:migrate",
    "db:seed": "pnpm --filter @habitos/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.5",
    "typescript": "5.9.3"
  }
}
